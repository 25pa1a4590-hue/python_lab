        "#palindrome\n",
        "def palindrome(n):\n",
        "  original = n\n",
        "  rev = 0\n",
        "  while(n!=0):\n",
        "    rem=n%10\n",
        "    rev=rev*10+rem\n",
        "    n=n//10\n",
        "  if(rev==original):\n",
        "    return True\n",
        "  else:\n",
        "    return False\n",
        "\n",
        "print(palindrome(252))\n",
        "print(palindrome(645))\n",
        "\n"
      ]
