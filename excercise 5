        "#find the no of vowels and consonants in a string\n",
        "a=str(input(\"enter a string\"))\n",
        "b=a.lower()\n",
        "vowels=['a','e','i','o','u']\n",
        "count_v=0\n",
        "count_c=0\n",
        "for ch in b:\n",
        "  if ch.isalpha():\n",
        "    if ch in vowels:\n",
        "      count_v+=1\n",
        "  else:\n",
        "      count_c+=1\n",
        "print(\"no of vowels\",count_v)\n",
        "print(\"no of consonants\",count_c)\n",
        "\n"
      ],
